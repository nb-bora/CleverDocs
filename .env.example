###############################################
# CleverDocs — Configuration (ENV)
#
# Format: KEY=VALUE
# - Les lignes commençant par # sont des commentaires.
# - Ce fichier contient des secrets (JWT_SECRET) : ne pas le commit.
# - Utilise `.env.example` comme modèle partageable.
###############################################

########################
# 🌍 Application (API)
########################
# APP_ENV : environnement d’exécution
# - dev  : mode développement (logs + reload possibles)
# - test : tests automatisés
# - prod : production (logs structurés, pas de debug)
APP_ENV=dev

# APP_NAME : nom logique du service (affichage, logs, observabilité)
APP_NAME=CleverDocs

# APP_HOST / APP_PORT : bind réseau de l’API
# - 0.0.0.0 : accessible depuis le réseau (Docker, LAN)
# - 127.0.0.1 : local uniquement
APP_HOST=0.0.0.0
APP_PORT=8000

# APP_LOG_LEVEL : niveau de logs (DEBUG, INFO, WARNING, ERROR)
APP_LOG_LEVEL=INFO

########################
# 🗃️ Base de données (PostgreSQL)
########################
# DATABASE_URL : DSN SQLAlchemy (driver psycopg3)
# Format:
#   postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
#
# Exemples:
# - Local:  postgresql+psycopg://cleverdocs:cleverdocs@localhost:5432/cleverdocs
# - Docker: postgresql+psycopg://cleverdocs:cleverdocs@db:5432/cleverdocs
DATABASE_URL=postgresql+psycopg://cleverdocs:cleverdocs@localhost:5432/cleverdocs

########################
# 🔎 Recherche (OpenSearch / Elasticsearch)
########################
# OPENSEARCH_URL : URL du cluster (MVP = single-node)
# - Local:  http://localhost:9200
# - Docker: http://opensearch:9200
OPENSEARCH_URL=http://localhost:9200

# OPENSEARCH_INDEX_PREFIX : préfixe pour les index (utile si multi-env)
# Exemple : cleverdocs-dev / cleverdocs-prod (selon ton naming)
OPENSEARCH_INDEX_PREFIX=cleverdocs

########################
# 🧠 OCR (EasyOCR)
########################
# OCR_LANGS : langues EasyOCR séparées par des virgules (ex: "fr,en")
OCR_LANGS=fr

# OCR_GPU : activer le GPU (nécessite un PyTorch/CUDA compatible)
OCR_GPU=false

# OCR_PDF_MAX_PAGES : limite de pages OCR (évite les PDFs énormes)
OCR_PDF_MAX_PAGES=20

# OCR_PDF_ZOOM : facteur de rendu PDF->image (2.0 est un bon default pour OCR)
OCR_PDF_ZOOM=2.0

########################
# 🗂️ Stockage de fichiers
########################
# STORAGE_BACKEND : backend de stockage
# - local : stockage sur disque (MVP)
# - s3    : stockage compatible S3 (prod)
STORAGE_BACKEND=local

# LOCAL_STORAGE_DIR : dossier de stockage local (relatif à la racine du repo ou chemin absolu)
# Recommandation : garder `storage/` ignoré par git
LOCAL_STORAGE_DIR=storage

########################
# 🔐 Sécurité (JWT) — placeholders pour les phases IAM
########################
# JWT_SECRET : secret de signature des tokens JWT
# - DEV : valeur simple ok
# - PROD : DOIT être long, aléatoire, stocké dans un secret manager
JWT_SECRET=change-me-dev

# JWT_ALGORITHM : algorithme de signature
# - HS256 : HMAC (simple)
# (option future) RS256 : clés publique/privée
JWT_ALGORITHM=HS256

