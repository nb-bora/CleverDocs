# --- App ---
APP_ENV=dev
APP_NAME=CleverDocs
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://cleverdocs:cleverdocs@localhost:5432/cleverdocs

# --- Search (OpenSearch/Elasticsearch compatible) ---
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_PREFIX=cleverdocs

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage

# --- Security (placeholders for later phases) ---
JWT_SECRET=change-me
JWT_ALGORITHM=HS256

